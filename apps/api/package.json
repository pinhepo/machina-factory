{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "worker": "bun run src/worker.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate:apply": "bun run src/lib/db/migrate.ts",
    "db:check": "bun run scripts/check-migrations.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@machina-factory/agent": "workspace:*",
    "@machina-factory/sandbox": "workspace:*",
    "@machina-factory/shared": "workspace:*",
    "@neondatabase/serverless": "^1.0.2",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "ai": "catalog:",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.7.0",
    "nanoid": "^5.1.6",
    "postgres": "^3.4.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^22",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5"
  }
}
