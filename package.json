{
  "name": "machina-factory",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "ai": "^6.0.141",
      "@ai-sdk/anthropic": "^3.0.64",
      "@ai-sdk/openai": "^3.0.49",
      "@ai-sdk/react": "^3.0.143",
      "zod": "^4.3.6"
    }
  },
  "scripts": {
    "dev": "bun run --cwd apps/api dev",
    "start": "bun run --cwd apps/api start",
    "worker": "bun run --cwd apps/api worker",
    "typecheck": "turbo typecheck",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "ci": "bun run check && bun run typecheck && bun run test:isolated",
    "test:isolated": "bun run scripts/test-isolated.ts",
    "test:verbose": "bun test --reporter=junit --reporter-outfile /dev/stdout",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate:apply",
    "docker:build-sandbox": "docker build -t machina-factory/sandbox-base:latest docker/sandbox-base/"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@neondatabase/serverless": "^1.0.2",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.12",
    "nanoid": "^5.1.7",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "oxfmt": "^0.43.0",
    "oxlint": "1.57.0",
    "turbo": "^2.5.4",
    "typescript": "^5",
    "ultracite": "7.4.0"
  },
  "overrides": {
    "zod": "^4.3.6"
  },
  "packageManager": "bun@1.2.14"
}
